map $arg_mode $injected_api_key {
    default     "${API_SECRET}";
    "valid"     "${API_SECRET}";
    "invalid"   "INVALID_KEY_TEST";
    "none"      "";
}

server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Disable caching for static assets during testing
    location ~* \.(html|js|css)$ {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
        try_files $uri =404;
    }

    # SPA routing - fallback to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Public health check endpoint proxy route
    location /health {
        proxy_pass ${BACKEND_URL}/health;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Protected API proxy route with Server-Side Credential Offloading
    location /api/ {
        proxy_pass ${BACKEND_URL}/api/;

        # Header Injection: Nginx injects the API key server-side based on test mode
        proxy_set_header x-api-key $injected_api_key;

        # Standard Proxy Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Internal Crypto Service Proxy Route (Internal Loopback on port 8000)
    location /crypto/ {
        proxy_pass http://127.0.0.1:8000/crypto/;

        # Standard Proxy Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # LDAP Authentication Proxy Route
    location /ldap/ {
        proxy_pass ${LDAP_API_URL}/;

        # Standard Proxy Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
